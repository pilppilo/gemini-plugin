{
  "schemaVersion": 1,
  "id": "gemini-usage",
  "name": "Gemini & Antigravity Usage",
  "version": "1.0.0",
  "author": "pilppilo",
  "license": "MIT",
  "description": "Weekly and daily Google Gemini / Antigravity usage, rate limits, pace, and session history in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Gemini Usage",
    "description": "Google Gemini and Antigravity quota, allowances, pace, and session breakdown at a glance.",
    "category": "AI",
    "aliases": [
      "gemini-usage",
      "antigravity-usage",
      "gemini",
      "agy-usage"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300,
      "sessionAllowance": 50,
      "weeklyAllowance": 500,
      "showLabel": false
    },
    "schema": [
      {
        "key": "showLabel",
        "type": "boolean",
        "label": "Show text label in bar",
        "defaultValue": false
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 300
      },
      {
        "key": "sessionAllowance",
        "type": "integer",
        "label": "5-hour session prompt allowance",
        "min": 10,
        "max": 500,
        "step": 10,
        "defaultValue": 50
      },
      {
        "key": "weeklyAllowance",
        "type": "integer",
        "label": "Weekly prompt allowance",
        "min": 50,
        "max": 5000,
        "step": 50,
        "defaultValue": 500
      }
    ]
  }
}